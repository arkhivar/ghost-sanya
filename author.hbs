{{!< default}}

<section class="archive-section">
    <header class="article-header">
        <a class="article-back text-link" href="/">← Вернуться к истории</a>
        <p class="eyebrow">Личный путеводитель</p>
        <h1>От первого лица</h1>
        <p class="archive-description article-excerpt">Я выбираю место для нашего месяца на Хайнане. Делюсь тем, что уже удалось выяснить, и сохраняю вопросы, которые помогут выбрать осознанно.</p>
    </header>

    <div class="archive-grid">
        {{#foreach posts}}
            {{> "card"}}
        {{else}}
            <p class="archive-description">Первые заметки ещё впереди. <a href="/">Начать с острова →</a></p>
        {{/foreach}}
    </div>

{{#if pagination}}
    {{#with pagination}}
    <nav class="archive-pagination" aria-label="Страницы публикаций">
        {{#if prev}}<a class="text-link" href="{{page_url prev}}" rel="prev">← Предыдущие</a>{{/if}}
        <span>Страница {{page}} из {{pages}}</span>
        {{#if next}}<a class="text-link" href="{{page_url next}}" rel="next">Следующие →</a>{{/if}}
    </nav>
    {{/with}}
{{/if}}

</section>
