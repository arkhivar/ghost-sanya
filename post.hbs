{{!< default}}

{{#post}}
<article class="atlas-article {{post_class}}">
    <header class="article-header">
        <a class="article-back text-link" href="/#bays">← Вернуться к карте</a>
        <p class="eyebrow">{{#if primary_tag}}{{primary_tag.name}}{{else}}Заметки к путешествию{{/if}}</p>
        <h1>{{title}}</h1>
        {{#if custom_excerpt}}<p class="article-excerpt">{{custom_excerpt}}</p>{{/if}}
        <div class="article-meta">
            <span>От первого лица</span>
            <span aria-hidden="true">·</span>
            <span>{{reading_time minute="1 мин" minutes="% мин"}}</span>
            <span aria-hidden="true">·</span>
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD.MM.YYYY"}}</time>
        </div>
    </header>

    {{#if feature_image}}
    <figure class="article-feature">
        <img
            src="{{img_url feature_image size="xl"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            fetchpriority="high"
        >
        {{#if feature_image_caption}}<figcaption>{{{feature_image_caption}}}</figcaption>{{/if}}
    </figure>
    {{/if}}

    <div class="gh-content gh-canvas article-body">
        {{content}}
    </div>

    <footer class="article-footer">
        {{#if tags}}
        <div class="article-tags" aria-label="Темы публикации">
            {{#foreach tags}}<a href="{{url}}">{{name}}</a>{{/foreach}}
        </div>
        {{/if}}
        <p>Продолжим собирать наш месяц у моря.</p>
        <nav aria-label="Продолжить путешествие">
            <a class="text-link" href="/#compare">Сравнить бухты →</a>
            <a class="text-link" href="/#stay">Посмотреть жильё →</a>
        </nav>
    </footer>
</article>
{{/post}}
