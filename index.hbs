{{!< default}}

<section class="archive-section">
    <header class="article-header">
        <a class="article-back text-link" href="/">← Вернуться к истории</a>
        <p class="eyebrow">Наш открытый блокнот</p>
        <h1>Места, к которым<br>хочется присмотреться</h1>
        <p class="archive-description article-excerpt">Бухты, жильё и детали повседневной жизни. Я собираю их вместе, чтобы понять, каким будет наш месяц на Хайнане.</p>
    </header>

    <div class="archive-grid">
        {{#foreach posts}}
            {{> "card"}}
        {{else}}
            <p class="archive-description">Здесь появятся первые заметки. А пока можно познакомиться с островом на <a href="/">главной странице</a>.</p>
        {{/foreach}}
    </div>

{{#if pagination}}
    {{#with pagination}}
    <nav class="archive-pagination" aria-label="Страницы публикаций">
        {{#if prev}}<a class="text-link" href="{{page_url prev}}" rel="prev">← Предыдущие</a>{{/if}}
        <span>Страница {{page}} из {{pages}}</span>
        {{#if next}}<a class="text-link" href="{{page_url next}}" rel="next">Следующие →</a>{{/if}}
    </nav>
    {{/with}}
{{/if}}

</section>
