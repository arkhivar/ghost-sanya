<article class="stay-row" data-stay="{{slug}}" data-stay-tags="{{#foreach tags}}{{slug}} {{/foreach}}">
    <div class="stay-index">{{@number}}</div>
    <div class="stay-name">
        <div class="stay-tags">
            {{#foreach tags}}
                {{#match slug "sanya-bay"}}<a class="stay-bay-tag" href="{{url}}">{{name}}</a>{{/match}}
                {{#match slug "dadonghai"}}<a class="stay-bay-tag" href="{{url}}">{{name}}</a>{{/match}}
                {{#match slug "yalong-bay"}}<a class="stay-bay-tag" href="{{url}}">{{name}}</a>{{/match}}
                {{#match slug "haitang-bay"}}<a class="stay-bay-tag" href="{{url}}">{{name}}</a>{{/match}}
                {{#match slug "apartments"}}<span class="eyebrow">{{name}}</span>{{/match}}
                {{#match slug "hotels"}}<span class="eyebrow">{{name}}</span>{{/match}}
            {{/foreach}}
        </div>
        <h3><a href="{{url}}" data-stay-name>{{title}}</a></h3>
        <p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="30"}}{{/if}}</p>
    </div>
    <div class="stay-feature" data-stay-feature>Условия — в заметке<small>Загружаю характеристики</small></div>
    <button class="save-stay" type="button" data-save="{{slug}}" aria-pressed="false" aria-label="Добавить к сравнению {{title}}">
        <span class="save-symbol">+</span><span class="save-text">К сравнению</span>
    </button>
    <a class="stay-open" href="{{url}}" aria-label="Подробнее: {{title}}"><svg class="icon"><use href="#i-arrow" /></svg></a>
</article>
