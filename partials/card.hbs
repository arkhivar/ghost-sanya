<article class="archive-card {{post_class}}">
    <a href="{{url}}" aria-label="{{title}}">
        {{#if feature_image}}
        <img
            src="{{img_url feature_image size="m"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            loading="lazy"
        >
        {{/if}}
        <div class="archive-card-content">
            <span class="eyebrow">{{#if primary_tag}}{{primary_tag.name}}{{else}}Заметки к путешествию{{/if}}</span>
            <h2>{{title}}</h2>
            <p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="28"}}{{/if}}</p>
            <span class="text-link">Рассмотреть подробнее <span aria-hidden="true">↗</span></span>
        </div>
    </a>
</article>
