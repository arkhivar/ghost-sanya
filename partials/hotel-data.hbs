{{!-- Public Ghost post data. Locations are maintained separately with sources. --}}
<div data-atlas-hotels hidden>
    {{#get "posts" filter="tag:stays" include="tags" limit="100"}}
        {{#foreach posts}}
            <article data-hotel-slug="{{slug}}">
                <h3 class="hotel-source-title">{{title}}</h3>
                <p class="hotel-source-excerpt">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="32"}}{{/if}}</p>
                <a class="hotel-source-link" href="{{url}}">{{title}}</a>
                {{#if feature_image}}
                    <img class="hotel-source-image" src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy">
                {{/if}}
            </article>
        {{/foreach}}
    {{/get}}
</div>
