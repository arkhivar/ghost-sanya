{{!< default}}

<section class="archive-section">
    {{#tag}}
    <header class="article-header">
        <a class="article-back text-link" href="/#compare">← Вернуться к сравнению бухт</a>
        <p class="eyebrow">Заметки по теме</p>
        <h1>{{name}}</h1>
        {{#if description}}
            <p class="archive-description article-excerpt">{{description}}</p>
        {{else}}
            <p class="archive-description article-excerpt">Всё, что я собираю об этой части нашего будущего путешествия: места, возможности и вопросы, на которые ещё предстоит ответить.</p>
        {{/if}}
    </header>
    {{/tag}}

    <div class="archive-grid">
        {{#foreach posts}}
            {{> "card"}}
        {{else}}
            <p class="archive-description">Пока здесь тихо. Можно вернуться к <a href="/#compare">сравнению бухт</a>.</p>
        {{/foreach}}
    </div>

{{#if pagination}}
    {{#with pagination}}
    <nav class="archive-pagination" aria-label="Страницы публикаций">
        {{#if prev}}<a class="text-link" href="{{page_url prev}}" rel="prev">← Предыдущие</a>{{/if}}
        <span>Страница {{page}} из {{pages}}</span>
        {{#if next}}<a class="text-link" href="{{page_url next}}" rel="next">Следующие →</a>{{/if}}
    </nav>
    {{/with}}
{{/if}}

</section>
