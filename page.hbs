{{!< default}}

{{#post}}
<article class="atlas-article {{post_class}}">
    {{#if @page.show_title_and_feature_image}}
    <header class="article-header">
        <a class="article-back text-link" href="/">← На главную</a>
        <p class="eyebrow">Месяц на Хайнане</p>
        <h1>{{title}}</h1>
        {{#if custom_excerpt}}<p class="article-excerpt">{{custom_excerpt}}</p>{{/if}}
    </header>

    {{#if feature_image}}
    <figure class="article-feature">
        <img
            src="{{img_url feature_image size="xl"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            fetchpriority="high"
        >
        {{#if feature_image_caption}}<figcaption>{{{feature_image_caption}}}</figcaption>{{/if}}
    </figure>
    {{/if}}

    {{/if}}
    <div class="gh-content gh-canvas article-body">
        {{content}}
    </div>

    <footer class="article-footer">
        <a class="text-link" href="/#bays">Карта нашей будущей поездки →</a>
    </footer>
</article>
{{/post}}
